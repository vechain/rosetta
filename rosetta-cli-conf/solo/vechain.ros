// Constructor DSL for check:construction against thor solo (network "custom").
//
// VTHO has a "dynamic" balance exemption (it accrues every block), and
// check:construction never looks balances up by block, so the CLI's view of
// any VTHO balance it has seen change drops to 0. Workflows therefore select
// senders by VET balance only: accounts created here receive < 0.1 VET, so
// only the prefunded accounts (which also hold plenty of VTHO for gas) qualify.

create_account(1){
  create{
    network = {"network":"custom", "blockchain":"vechainthor"};
    key = generate_key({"curve_type": "secp256k1"});
    account = derive({
      "network_identifier": {{network}},
      "public_key": {{key.public_key}}
    });
    save_account({
      "account_identifier": {{account.account_identifier}},
      "keypair": {{key}}
    });
  }
}

transfer_vet(1){
  transfer{
    transfer.network = {"network":"custom", "blockchain":"vechainthor"};
    currency = {"symbol":"VET", "decimals":18};
    sender = find_balance({
      "minimum_balance":{"value": "1000000000000000000", "currency": {{currency}}}
    });
    recipient_amount = random_number({"minimum": "1", "maximum": "100000000000000000"});
    sender_amount = 0 - {{recipient_amount}};
    recipient = find_balance({
      "not_account_identifier":[{{sender.account_identifier}}],
      "minimum_balance":{"value": "0", "currency": {{currency}}},
      "create_limit": 10,
      "create_probability": 50
    });
    transfer.confirmation_depth = "1";
    transfer.operations = [
      {"operation_identifier":{"index":0},"type":"Transfer","account":{{sender.account_identifier}},
       "amount":{"value":{{sender_amount}},"currency":{{currency}}}},
      {"operation_identifier":{"index":1},"type":"Transfer","account":{{recipient.account_identifier}},
       "amount":{"value":{{recipient_amount}},"currency":{{currency}}}}
    ];
  }
}

transfer_vtho(1){
  transfer{
    transfer.network = {"network":"custom", "blockchain":"vechainthor"};
    vet = {"symbol":"VET", "decimals":18};
    currency = {"symbol":"VTHO", "decimals":18, "metadata":{"contractAddress":"0x0000000000000000000000000000456e65726779"}};
    sender = find_balance({
      "minimum_balance":{"value": "1000000000000000000", "currency": {{vet}}}
    });
    recipient = find_balance({
      "not_account_identifier":[{{sender.account_identifier}}],
      "minimum_balance":{"value": "0", "currency": {{vet}}},
      "create_limit": 10,
      "create_probability": 50
    });
    recipient_amount = "10000000000000000";
    sender_amount = 0 - {{recipient_amount}};
    transfer.confirmation_depth = "1";
    transfer.operations = [
      {"operation_identifier":{"index":0},"type":"Transfer","account":{{sender.account_identifier}},
       "amount":{"value":{{sender_amount}},"currency":{{currency}}}},
      {"operation_identifier":{"index":1},"type":"Transfer","account":{{recipient.account_identifier}},
       "amount":{"value":{{recipient_amount}},"currency":{{currency}}}}
    ];
  }
}
